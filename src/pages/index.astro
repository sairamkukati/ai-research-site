---
import { getCollection, render } from 'astro:content';
import "../styles/global.css";

const reports = await getCollection('reports');

function getReportTime(report) {
  const id = report.id.replace(/\.md$/, '');

  // YYYY-MM-DD-HH-mm-ss
  const timestampMatch = id.match(
    /(\d{4}-\d{2}-\d{2})(?:-(\d{2})-(\d{2})-(\d{2}))?$/
  );

  if (!timestampMatch) {
    return 0;
  }

  const [, date, hour = "00", minute = "00", second = "00"] =
    timestampMatch;

  return new Date(
    `${date}T${hour}:${minute}:${second}`
  ).getTime();
}

reports.sort((a, b) => {
  return getReportTime(b) - getReportTime(a);
});

const latest = reports[0];

let Content;

if (latest) {
  ({ Content } = await render(latest));
}
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>AI Research Daily</title>
  </head>

  <body>

    <header class="site-header">
      <div class="container header-inner">

        <div>
          <div class="logo">🤖 AI Research Daily</div>
          <div class="tagline">
            AI research • technology • startup intelligence
          </div>
        </div>

        <a class="archive-link" href="#archive">
          Archive
        </a>

      </div>
    </header>


    <main class="container">

      {latest && (
        <>
          <section class="hero">

            <div class="date">
              {latest.data.date}
            </div>

            <h1>
              AI Research Daily
            </h1>

            <p class="tagline">
              Today's AI developments, trends and ideas.
            </p>

          </section>


          <article>
            <Content />
          </article>
        </>
      )}


      <section id="archive" class="archive">

  <h2>📚 Previous Reports</h2>

  {
    reports.slice(1, 4).map((report) => {
      const slug = report.id.replace(/\.md$/, '');

      return (
        <a
          class="archive-item"
          href={`${import.meta.env.BASE_URL}reports/${slug}`}
        >
          <strong>{report.data.date}</strong>

          <span>
            → Read report
          </span>
        </a>
      );
    })
  }

  <div style="margin-top: 24px;">
    <a class="archive-link" href={`${import.meta.env.BASE_URL}archive`}>
      View full archive →
    </a>
  </div>

</section>

    </main>


    <footer>
      <div class="container">
        Generated automatically by n8n + Gemini.
      </div>
    </footer>

  </body>
</html>